div(class="flex flex-col h-full bg-white")
    div(class="flex items-center justify-between border-b border-gray-200 px-6 py-3 flex-shrink-0")
        div(class="flex items-center gap-3")
            div(class="flex items-center justify-center w-8 h-8 rounded-lg bg-gradient-to-br from-violet-500 to-indigo-600 text-white")
                svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor", class="size-5")
                    path(stroke-linecap="round", stroke-linejoin="round", d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 0 0-2.455 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z")
            h1(class="text-lg font-semibold text-gray-900") AI Research Assistant (v2)

    div(#chatContainer="", class="flex-1 min-h-0 overflow-y-auto px-4 py-4 space-y-4")
        div(*ngIf="chatMessages.length === 0", class="flex flex-col items-center justify-center h-full text-center")
            h2(class="text-lg font-semibold text-gray-900 mb-2") 플라즈마 연구 AI 어시스턴트 (v2)
            p(class="text-[13px] text-gray-500 max-w-md") v2 엔드포인트로 스트리밍을 테스트합니다.

        ng-container(*ngFor="let msg of chatMessages; let i = index")
            div(*ngIf="msg.role === 'user'", class="flex justify-end")
                div(class="max-w-[75%]")
                    div(class="px-4 py-2.5 bg-indigo-600 text-white rounded-2xl rounded-br-md text-[13px] leading-relaxed whitespace-pre-wrap") {{msg.content}}

            div(*ngIf="msg.role === 'assistant'", class="flex justify-start")
                div(class="max-w-[85%] space-y-2")
                    div(*ngIf="msg.navigationCard", class="rounded-2xl border px-4 py-3", [ngClass]="msg.navigationCard.loading ? 'border-cyan-200 bg-cyan-50/70' : 'border-cyan-300 bg-cyan-50'")
                        div(class="mb-2 flex items-center gap-2")
                            span(class="text-sm") 🧭
                            span(class="text-[12px] font-semibold text-cyan-800") 페이지 핸드오프
                        p(class="text-[12px] leading-5 text-cyan-700") {{msg.navigationCard.summary}}

                    div(*ngIf="msg.pageResultCard", class="rounded-2xl border px-4 py-3", [ngClass]="msg.pageResultCard.loading ? 'border-violet-100 bg-violet-50/50' : 'border-violet-200 bg-violet-50'")
                        div(class="mb-2 flex items-center gap-2")
                            span(class="text-sm") 🧾
                            span(class="text-[12px] font-semibold text-violet-800") 실행된 페이지 결과
                        p(class="text-[12px] font-medium text-violet-900") {{msg.pageResultCard.page}} / {{msg.pageResultCard.tab}}
                        p(class="mt-1 text-[12px] leading-5 text-violet-700") {{msg.pageResultCard.summary}}
                        p(*ngIf="msg.pageResultCard.query", class="mt-2 text-[11px] text-violet-700") 질문 키워드: {{msg.pageResultCard.query}}
                        p(*ngIf="msg.pageResultCard.paramsText", class="mt-1 text-[11px] text-violet-700") 적용 인자값: {{msg.pageResultCard.paramsText}}
                        div(*ngIf="msg.pageResultCard.evidenceLines?.length > 0", class="mt-2 space-y-1")
                            p(*ngFor="let line of msg.pageResultCard.evidenceLines", class="text-[11px] leading-5 text-violet-700") • {{line}}

                    div(*ngIf="msg.content || msg.previewContent || msg.typingActive", class="px-4 py-3 bg-gray-50 border border-gray-200 rounded-2xl rounded-bl-md text-[13px] leading-relaxed")
                        div(*ngIf="msg.content", [innerHTML]="renderMarkdown(msg.content)")
                        div(*ngIf="!msg.content", class="space-y-2")
                            p(class="text-[11px] font-medium text-gray-500") 현재까지 핵심 포인트
                            p(*ngFor="let line of getAssistantPreviewLines(msg)", class="text-[12px] leading-5 text-gray-700") • {{line}}
                            div(class="flex items-center gap-1 pt-1")
                                div(class="h-1.5 w-1.5 rounded-full bg-violet-300 animate-bounce", style="animation-delay: 0ms")
                                div(class="h-1.5 w-1.5 rounded-full bg-violet-300 animate-bounce", style="animation-delay: 150ms")
                                div(class="h-1.5 w-1.5 rounded-full bg-violet-300 animate-bounce", style="animation-delay: 300ms")
                    div(*ngIf="shouldShowQualityCard(msg)", class="rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3")
                        div(class="mb-2 flex items-center gap-2")
                            span(class="text-sm") 🧪
                            span(class="text-[12px] font-semibold text-emerald-800") 답변 품질 분석
                        div(*ngIf="getQualityBadges(msg).length > 0", class="mb-2 flex flex-wrap gap-1.5")
                            span(*ngFor="let badge of getQualityBadges(msg)", class="inline-flex items-center rounded-full border border-emerald-200 bg-white px-2 py-0.5 text-[10px] font-medium text-emerald-700") {{badge}}
                        p(*ngIf="msg.answerQuality?.detail", class="text-[12px] leading-5 text-emerald-800") {{msg.answerQuality.detail}}
                        p(*ngIf="!msg.answerQuality?.detail", class="text-[12px] leading-5 text-emerald-700") 근거 수와 검증 포인트를 정리하며 답변 품질을 점검하고 있습니다.
                        div(*ngIf="msg.answerQuality?.synthesisPoints?.length > 0", class="mt-2 space-y-1")
                            p(*ngFor="let point of msg.answerQuality.synthesisPoints", class="text-[11px] leading-5 text-emerald-700") • {{point}}
                        div(*ngIf="msg.answerQuality?.verificationChecks?.length > 0", class="mt-2 space-y-1")
                            p(*ngFor="let check of msg.answerQuality.verificationChecks", class="text-[11px] leading-5 text-emerald-700") ✓ {{check}}

    div(class="flex-shrink-0 border-t border-gray-200 px-4 py-3 bg-white")
        div(class="flex items-end gap-2 max-w-4xl mx-auto")
            div(class="flex-1 relative")
                textarea(#chatInputEl="", [(ngModel)]="chatInput", (keydown)="onKeydown($event)", placeholder="플라즈마 연구에 대해 질문하세요...", rows="1", class="w-full resize-none rounded-xl border border-gray-300 bg-white px-4 py-2.5 text-[13px] text-gray-900 placeholder-gray-400 focus:border-violet-500 focus:ring-1 focus:ring-violet-500 focus:outline-none transition-colors", style="max-height: 120px; min-height: 40px;")
            button(*ngIf="!chatLoading", (click)="sendChat()", [disabled]="!chatInput.trim()", class="flex-shrink-0 flex items-center justify-center w-10 h-10 rounded-xl text-white transition-colors", [class]="chatInput.trim() ? 'bg-violet-600 hover:bg-violet-700' : 'bg-gray-300 cursor-not-allowed'")
                svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor", class="size-5")
                    path(stroke-linecap="round", stroke-linejoin="round", d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5")
            button(*ngIf="chatLoading", (click)="cancelChat()", class="flex-shrink-0 flex items-center justify-center w-10 h-10 rounded-xl bg-red-500 hover:bg-red-600 text-white transition-colors")
                svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor", class="size-5")
                    path(stroke-linecap="round", stroke-linejoin="round", d="M5.25 7.5A2.25 2.25 0 0 1 7.5 5.25h9a2.25 2.25 0 0 1 2.25 2.25v9a2.25 2.25 0 0 1-2.25 2.25h-9a2.25 2.25 0 0 1-2.25-2.25v-9Z")
