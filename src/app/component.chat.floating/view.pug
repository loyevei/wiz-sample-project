//- Floating Chat Button
button((click)="toggleChat()", class="fixed bottom-6 right-6 z-[9999] flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-violet-600 to-indigo-600 shadow-lg transition-all duration-300 hover:scale-105 hover:shadow-xl", [ngClass]="isOpen ? 'scale-0 opacity-0 pointer-events-none' : 'scale-100 opacity-100'")
    img(src="/assets/brand/plasma-robot.svg", alt="bot", class="h-8 w-8")

//- Chat Window
div(class="fixed bottom-6 right-6 z-[9999] origin-bottom-right transition-all duration-300", [ngClass]="isOpen ? 'scale-100 opacity-100' : 'scale-0 opacity-0 pointer-events-none'")
    div(class="flex h-[720px] w-[460px] flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl")
        div(class="flex items-center justify-between border-b border-slate-200 bg-slate-900 px-4 py-3 text-white")
            div(class="flex min-w-0 items-center gap-2.5")
                div(class="flex h-7 w-7 items-center justify-center rounded-lg bg-gradient-to-br from-violet-600 to-indigo-600")
                    img(src="/assets/brand/plasma-robot.svg", alt="bot", class="h-4 w-4")
                div(class="min-w-0")
                    span(class="text-[13px] font-semibold") {{robotProfile.name}}
                    span(*ngIf="robotProfile.tag", class="ml-2 text-[10px] font-medium text-slate-400") {{robotProfile.tag}}
            div(class="flex flex-shrink-0 items-center gap-0.5")
                button(*ngIf="collectionSelected && selectedCollection", (click)="changeCollection()", class="inline-flex items-center gap-1 rounded-md bg-white/10 px-2 py-1 text-[10px] font-medium text-slate-300 transition-colors hover:bg-white/20 hover:text-white", title="컬렉션 변경")
                    span(class="max-w-[72px] truncate") {{selectedCollection}}
                button((click)="clearChat()", class="rounded-md p-1.5 text-slate-400 transition-colors hover:bg-white/10 hover:text-white", title="대화 초기화")
                    svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor", class="size-4")
                        path(stroke-linecap="round", stroke-linejoin="round", d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182")
                button((click)="toggleChat()", class="rounded-md p-1.5 text-slate-400 transition-colors hover:bg-white/10 hover:text-white", title="닫기")
                    svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor", class="size-4")
                        path(stroke-linecap="round", stroke-linejoin="round", d="M19.5 8.25l-7.5 7.5-7.5-7.5")

        div(*ngIf="!collectionSelected", class="flex-1 min-h-0 overflow-y-auto bg-slate-50 px-5 py-6")
            div(class="flex h-full flex-col items-center justify-center")
                div(*ngIf="collectionsLoading", class="flex flex-col items-center gap-3")
                    div(class="h-12 w-12 rounded-full border-[3px] border-cyan-400 border-t-transparent animate-spin")
                    p(class="text-[13px] text-slate-500") 데이터베이스 로딩 중...
                div(*ngIf="!collectionsLoading", class="w-full max-w-[360px]")
                    div(class="mb-6 text-center")
                        div(class="mx-auto mb-3 flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-violet-600 to-indigo-600 shadow-md")
                            img(src="/assets/brand/plasma-robot.svg", alt="bot", class="h-8 w-8")
                        p(class="text-[14px] font-semibold text-slate-900") {{robotProfile.name}}
                        p(class="mt-1 text-[12px] leading-5 text-slate-500") 논문 검색에 사용할 컬렉션을 선택하세요.
                    div(*ngIf="collections.length === 0", class="rounded-2xl border border-dashed border-slate-200 bg-white px-5 py-7 text-center")
                        p(class="text-[13px] font-medium text-slate-600") 사용 가능한 컬렉션이 없습니다.
                        p(class="mt-1 text-[11px] text-slate-400") 먼저 임베딩 페이지에서 PDF를 업로드하세요.
                    div(*ngIf="collections.length > 0", class="space-y-3")
                        div(class="flex flex-wrap gap-2")
                            button(*ngFor="let col of collections", (click)="selectCollection(col.name)", class="inline-flex items-center gap-2 rounded-xl border px-3 py-2 text-[12px] font-medium transition-all", [ngClass]="selectedCollection === col.name ? 'border-violet-500 bg-violet-50 text-violet-700 ring-1 ring-violet-200' : 'border-slate-200 bg-white text-slate-700 hover:border-violet-300 hover:bg-violet-50'")
                                span(class="text-sm") 📄
                                span {{col.name}}
                                span(class="text-[10px] text-slate-400") {{col.total_docs}} docs

        div(*ngIf="collectionSelected", #chatBody="", class="flex-1 min-h-0 overflow-y-auto bg-white px-4 py-4 space-y-4")
            div(*ngIf="chatMessages.length === 0", class="flex h-full flex-col items-center justify-center text-center")
                div(class="mb-3 flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-violet-600 to-indigo-600 shadow-md")
                    img(src="/assets/brand/plasma-robot.svg", alt="bot", class="h-7 w-7")
                p(class="text-[14px] font-semibold text-slate-900") {{robotProfile.name}}
                p(class="mt-1 max-w-[300px] text-[12px] leading-5 text-slate-500") 무엇이든 물어보세요. 관련 논문을 검색하고 분석하여 답변합니다.
                div(class="mt-5 grid w-full max-w-[320px] gap-1.5")
                    button(*ngFor="let s of suggestions", (click)="sendChat(s.text)", class="flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-left text-[12px] text-slate-600 transition-all hover:border-violet-300 hover:bg-violet-50 hover:text-violet-700")
                        span(class="text-base") {{s.icon}}
                        span(class="truncate") {{s.text}}

            ng-container(*ngFor="let msg of chatMessages; let i = index")
                div(*ngIf="msg.role === 'user'", class="flex justify-end")
                    div(class="max-w-[84%] rounded-2xl rounded-br-sm bg-violet-600 px-3.5 py-2.5 text-[13px] leading-relaxed text-white shadow-sm whitespace-pre-wrap") {{msg.content}}

                div(*ngIf="msg.role === 'assistant'", class="flex gap-2.5")
                    div(class="flex-shrink-0 pt-0.5")
                        div(class="flex h-6 w-6 items-center justify-center rounded-lg bg-gradient-to-br from-violet-600 to-indigo-600 shadow-sm")
                            img(src="/assets/brand/plasma-robot.svg", alt="bot", class="h-3.5 w-3.5")
                    div(class="min-w-0 flex-1 space-y-1.5")
                        //- Collapsed turn
                        button(*ngIf="msg.collapsed", (click)="toggleCollapse(msg)", class="w-full rounded-lg border border-slate-200/60 bg-white/80 px-3 py-2 text-left text-[12px] text-slate-500 transition-colors hover:bg-slate-50")
                            div(class="flex items-center gap-2")
                                svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="2", stroke="currentColor", class="size-3 flex-shrink-0 text-slate-400")
                                    path(stroke-linecap="round", stroke-linejoin="round", d="m8.25 4.5 7.5 7.5-7.5 7.5")
                                span(class="truncate flex-1") {{getCollapsedPreview(msg)}}

                        ng-container(*ngIf="!msg.collapsed")
                            //- Thinking section (Copilot-style)
                            div(*ngIf="msg.traceSteps?.length > 0", class="copilot-thinking")
                                button((click)="msg.traceCompleted && toggleTrace(msg)", class="flex items-center gap-2 w-full py-1 text-left group")
                                    div(*ngIf="!msg.traceCompleted", class="flex-shrink-0")
                                        svg(class="size-4 animate-spin text-violet-500", viewBox="0 0 24 24")
                                            circle(class="opacity-25", cx="12", cy="12", r="10", stroke="currentColor", stroke-width="4", fill="none")
                                            path(class="opacity-75", fill="currentColor", d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z")
                                    svg(*ngIf="msg.traceCompleted", xmlns="http://www.w3.org/2000/svg", viewBox="0 0 20 20", fill="currentColor", class="size-4 flex-shrink-0 text-violet-500")
                                        path(fill-rule="evenodd", d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z", clip-rule="evenodd")
                                    span(class="text-[12px] font-medium", [ngClass]="msg.traceCompleted ? 'text-slate-500' : 'text-slate-700'") {{msg.traceCompleted ? 'Thinking 완료 · ' + getCompletedTraceCount(msg) + '단계' : 'Thinking...'}}
                                    span(*ngIf="!msg.traceCompleted && getCurrentTraceStep(msg)?.title", class="text-[11px] text-slate-400 truncate hidden sm:inline")  · {{getCurrentTraceStep(msg)?.title}}
                                    svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="2", stroke="currentColor", class="size-3 ml-auto text-slate-400 transition-transform flex-shrink-0 group-hover:text-slate-600", [class.rotate-90]="!msg.traceCompleted || msg.traceOpen")
                                        path(stroke-linecap="round", stroke-linejoin="round", d="m8.25 4.5 7.5 7.5-7.5 7.5")
                                div(*ngIf="!msg.traceCompleted || msg.traceOpen", class="mt-1 ml-2 pl-3.5 border-l-2 border-slate-200 space-y-0.5 pb-1")
                                    div(*ngFor="let step of msg.traceSteps", class="flex items-start gap-1.5 py-0.5 text-[11px]", [ngClass]="step.status === 'skipped' ? 'opacity-30' : ''")
                                        span(*ngIf="step.status === 'done'", class="mt-px text-emerald-500 flex-shrink-0") ✓
                                        span(*ngIf="step.status === 'running'", class="mt-px text-violet-500 flex-shrink-0") ◔
                                        span(*ngIf="step.status === 'pending'", class="mt-px text-slate-300 flex-shrink-0") ○
                                        span(*ngIf="step.status === 'error'", class="mt-px text-red-500 flex-shrink-0") ✕
                                        span(*ngIf="step.status === 'skipped'", class="mt-px text-slate-400 flex-shrink-0") ↷
                                        span(class="leading-relaxed")
                                            span(class="font-medium text-slate-700") {{step.title}}
                                            span(*ngIf="step.detail", class="text-slate-500")  — {{step.detail | slice:0:100}}

                            //- Tool calls (inline chips)
                            div(*ngIf="getUsedToolNames(msg).length > 0", class="flex flex-wrap gap-1.5 py-0.5")
                                button(*ngFor="let tn of getUsedToolNames(msg)", (click)="toggleTrace(msg)", class="inline-flex items-center gap-1 rounded-md border border-slate-200 bg-slate-50 px-2 py-0.5 text-[10px] font-medium text-slate-600 transition-colors hover:bg-slate-100")
                                    span {{getToolIcon(tn)}}
                                    span Used {{getToolLabel(tn)}}

                            //- Navigation (inline)
                            div(*ngIf="shouldRenderNavigationCard(msg)", class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2.5")
                                div(*ngIf="msg.navigationCard?.loading", class="flex items-center gap-2")
                                    svg(class="size-3.5 animate-spin text-slate-400", viewBox="0 0 24 24")
                                        circle(class="opacity-25", cx="12", cy="12", r="10", stroke="currentColor", stroke-width="4", fill="none")
                                        path(class="opacity-75", fill="currentColor", d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z")
                                    span(class="text-[11px] text-slate-500") {{msg.navigationCard?.summary || '페이지 이동 준비 중...'}}
                                div(*ngIf="!msg.navigationCard?.loading")
                                    div(class="flex items-center justify-between gap-2")
                                        div(class="flex items-center gap-1.5 text-[12px] text-slate-700")
                                            span 🧭
                                            span {{msg.navigationCard?.summary || buildAgentNavigationSummary(pendingNavigation)}}
                                        button(*ngIf="pendingNavigation", (click)="navigateNow()", class="flex-shrink-0 inline-flex items-center gap-1 rounded-md bg-violet-600 px-2.5 py-1 text-[11px] font-medium text-white transition-colors hover:bg-violet-500")
                                            span {{msg.navigationCard?.actionLabel || '이동'}}

                            //- Page result (inline)
                            div(*ngIf="shouldRenderPageResultCard(msg)", class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2.5 text-[11px]")
                                div(*ngIf="msg.pageResultCard.loading", class="flex items-center gap-2 text-slate-500")
                                    svg(class="size-3.5 animate-spin text-slate-400", viewBox="0 0 24 24")
                                        circle(class="opacity-25", cx="12", cy="12", r="10", stroke="currentColor", stroke-width="4", fill="none")
                                        path(class="opacity-75", fill="currentColor", d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z")
                                    span 🧾 {{msg.pageResultCard.page}}/{{msg.pageResultCard.tab}} 결과 분석 중...
                                div(*ngIf="!msg.pageResultCard.loading")
                                    p(class="font-medium text-slate-700") 🧾 {{msg.pageResultCard.page}} / {{msg.pageResultCard.tab}}
                                    p(class="mt-1 text-slate-600 leading-relaxed") {{msg.pageResultCard.summary}}
                                    div(*ngIf="msg.pageResultCard.evidenceLines?.length > 0", class="mt-1.5 space-y-0.5 text-slate-500")
                                        p(*ngFor="let line of msg.pageResultCard.evidenceLines") · {{line}}

                            //- Answer (clean, no card wrapper)
                            div(*ngIf="shouldRenderAnswerCard(msg)")
                                div(*ngIf="msg.content", class="chat-markdown-body text-[13px] leading-7 text-slate-800 break-words", [innerHTML]="getDisplayedAssistantContent(msg)")
                                span(*ngIf="msg.typingActive", class="inline-block h-4 w-0.5 animate-pulse bg-violet-500 align-middle rounded-full")
                                div(*ngIf="!msg.content", class="space-y-1.5")
                                    p(*ngFor="let line of getAssistantPreviewLines(msg)", class="text-[12px] leading-5 text-slate-600") {{line}}
                                    div(class="flex items-center gap-1 pt-1")
                                        div(class="h-1.5 w-1.5 rounded-full bg-violet-400 animate-bounce", style="animation-delay: 0ms")
                                        div(class="h-1.5 w-1.5 rounded-full bg-violet-400 animate-bounce", style="animation-delay: 150ms")
                                        div(class="h-1.5 w-1.5 rounded-full bg-violet-400 animate-bounce", style="animation-delay: 300ms")

                            //- Quality badges (inline, minimal)
                            div(*ngIf="shouldRenderQualityCard(msg) && getQualityBadges(msg).length > 0", class="flex flex-wrap gap-1.5")
                                span(*ngFor="let badge of getQualityBadges(msg)", class="inline-flex items-center rounded-md border border-slate-200 bg-slate-50 px-2 py-0.5 text-[10px] font-medium text-slate-500") {{badge}}

                            //- Evidence (expandable)
                            div(*ngIf="shouldRenderEvidenceCard(msg)", class="rounded-lg border border-slate-200 overflow-hidden")
                                button((click)="toggleEvidence(msg)", class="flex w-full items-center justify-between px-3 py-2 text-left text-[11px] transition-colors hover:bg-slate-50")
                                    span(class="font-medium text-slate-600") 📚 참고 문헌 {{msg.evidenceItems.length}}건
                                    svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="2", stroke="currentColor", class="size-3 text-slate-400 transition-transform", [ngClass]="{'rotate-180': msg.evidenceOpen}")
                                        path(stroke-linecap="round", stroke-linejoin="round", d="M19.5 8.25l-7.5 7.5-7.5-7.5")
                                div(*ngIf="msg.evidenceOpen", class="border-t border-slate-200 px-3 py-2 space-y-1.5 max-h-60 overflow-y-auto bg-slate-50")
                                    div(*ngFor="let ev of msg.evidenceItems; let i = index", class="rounded-md border border-slate-100 bg-white px-2.5 py-1.5")
                                        div(class="flex items-center justify-between gap-2")
                                            span(class="text-[10px] font-medium text-slate-700 truncate flex-1") {{i + 1}}. {{ev.filename || ev.doc_id || '문서'}}
                                            span(*ngIf="ev.score !== null && ev.score !== undefined", class="flex-shrink-0 text-[10px] text-slate-500") {{formatEvidenceScore(ev.score)}}
                                        div(*ngIf="ev.snippets?.length > 0", class="mt-1 space-y-0.5")
                                            p(*ngFor="let snip of ev.snippets", class="text-[10px] leading-4 text-slate-500 break-words") {{snip}}

                            //- Action bar
                            div(*ngIf="msg.content && !msg.typingActive", class="flex items-center gap-1 pt-0.5")
                                button((click)="copyAnswer(msg)", class="inline-flex items-center gap-1 rounded-md px-1.5 py-0.5 text-[10px] text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-600", title="답변 복사")
                                    svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor", class="size-3")
                                        path(stroke-linecap="round", stroke-linejoin="round", d="M15.666 3.888A2.25 2.25 0 0 0 13.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 0 1-.75.75H9.75a.75.75 0 0 1-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 0 1 1.927-.184")
                                    span 복사

            div(*ngIf="chatLoading", class="flex gap-2.5")
                div(class="flex-shrink-0 pt-0.5")
                    div(class="flex h-6 w-6 items-center justify-center rounded-lg bg-gradient-to-br from-violet-600 to-indigo-600 shadow-sm")
                        img(src="/assets/brand/plasma-robot.svg", alt="bot", class="h-3.5 w-3.5")
                div(class="flex items-center gap-1.5 pt-1")
                    div(class="h-1.5 w-1.5 rounded-full bg-violet-500 animate-bounce", style="animation-delay: 0ms")
                    div(class="h-1.5 w-1.5 rounded-full bg-violet-500 animate-bounce", style="animation-delay: 150ms")
                    div(class="h-1.5 w-1.5 rounded-full bg-violet-500 animate-bounce", style="animation-delay: 300ms")

        div(*ngIf="collectionSelected", class="border-t border-slate-200 bg-white px-4 py-3")
            div(class="flex items-end gap-2")
                div(class="flex-1")
                    textarea(#chatInputEl="", [(ngModel)]="chatInput", (keydown)="onKeydown($event)", placeholder="질문을 입력하세요...", rows="1", class="max-h-28 w-full resize-none rounded-xl border border-slate-300 px-3.5 py-2.5 text-[13px] leading-6 text-slate-800 outline-none transition-colors focus:border-violet-400 focus:ring-2 focus:ring-violet-100", [disabled]="chatLoading")
                button(*ngIf="!chatLoading", (click)="sendChat()", [disabled]="!chatInput.trim()", class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-violet-600 text-white transition-colors hover:bg-violet-500 disabled:cursor-not-allowed disabled:opacity-40")
                    svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="2", stroke="currentColor", class="size-4")
                        path(stroke-linecap="round", stroke-linejoin="round", d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5")
                button(*ngIf="chatLoading", (click)="cancelChat()", class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-rose-500 text-white transition-colors hover:bg-rose-400")
                    svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="2", stroke="currentColor", class="size-4")
                        path(stroke-linecap="round", stroke-linejoin="round", d="M5.25 7.5A2.25 2.25 0 017.5 5.25h9a2.25 2.25 0 012.25 2.25v9a2.25 2.25 0 01-2.25 2.25h-9a2.25 2.25 0 01-2.25-2.25v-9z")
